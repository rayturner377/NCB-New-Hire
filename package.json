{
  "name": "confidential-medical-review",
  "version": "1.0.0",
  "private": true,
  "description": "Secure new-hire medical assessment intake and review platform.",
  "main": "server.js",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node server.js",
    "user:upsert": "node scripts/upsert-user.js",
    "dev": "dotenv -- turbo run dev",
    "build": "dotenv -- turbo run build",
    "test": "dotenv -- turbo run test",
    "test:coverage": "dotenv -- turbo run test:coverage",
    "test:integration": "dotenv -- turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "dotenv -- turbo run typecheck",
    "db:generate": "dotenv -- npm run generate -w @ncb/database",
    "db:migrate:dev": "dotenv -- npm run migrate:dev -w @ncb/database",
    "db:migrate:deploy": "dotenv -- npm run migrate:deploy -w @ncb/database",
    "db:verify-audit-chain": "dotenv -- npm run verify-audit-chain -w @ncb/database"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.11",
    "@netlify/functions": "^4.2.5",
    "mysql2": "^3.14.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true,
    "sharp@0.34.5": true
  }
}
