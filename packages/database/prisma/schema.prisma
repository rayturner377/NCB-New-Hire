// Prisma schema mirroring database/migrations/postgres/001-initial-schema.js exactly
// (table/column names preserved via @map/@@map) so it can be pointed at a database
// already migrated by the legacy runner, or manage migrations itself going forward.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id             String    @id @db.VarChar(80)
  email          String    @unique @db.VarChar(254)
  displayName    String    @map("display_name") @db.VarChar(140)
  role           String    @db.VarChar(30)
  active         Boolean   @default(true)
  passwordRecord Json?     @map("password_record")
  medicalProfile Json      @default("{}") @map("medical_profile")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdPatientProfiles PatientProfile[]      @relation("PatientCreatedBy")
  linkedPatientProfiles  PatientProfile[]      @relation("PatientLinkedUser")
  officeMemberships      MedicalOfficeMember[]
  createdCases           MedicalCase[]         @relation("CaseCreatedBy")
  assignedCases          MedicalCase[]         @relation("CaseAssignedClinician")
  reviewedCases          MedicalCase[]         @relation("CaseReviewedBy")
  submissions            MedicalSubmission[]   @relation("SubmissionSubmittedBy")
  attachments            CaseAttachment[]      @relation("AttachmentUploadedBy")
  settingUpdates         ApplicationSetting[]  @relation("SettingUpdatedBy")
  sessions               Session[]

  @@index([role, active], map: "idx_users_role_active")
  @@map("app_users")
}

/// Replaces the old in-memory `sessions = new Map()` in server.js (~L63) — a
/// real scaling/HA bug (a restart logs everyone out, and it couldn't run more
/// than one instance). Backed by Postgres so apps/web can run as more than a
/// single process.
model Session {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(80)
  csrfToken String   @map("csrf_token") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

model PatientProfile {
  id                String    @id @db.VarChar(80)
  linkedUserId      String?   @map("linked_user_id") @db.VarChar(80)
  fullName          String    @map("full_name") @db.VarChar(140)
  email             String?   @db.VarChar(254)
  employeeId        String?   @map("employee_id") @db.VarChar(80)
  nationalIdHash    String?   @map("national_id_hash") @db.Char(64)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  contactNumber     String?   @map("contact_number") @db.VarChar(50)
  profilePayload    Bytes?    @map("profile_payload")
  payloadKeyVersion  Int       @default(1) @map("payload_key_version") @db.SmallInt
  createdBy         String?   @map("created_by") @db.VarChar(80)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  linkedUser AppUser? @relation("PatientLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  creator    AppUser? @relation("PatientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  cases      MedicalCase[]

  @@index([email], map: "idx_patients_email")
  @@index([employeeId], map: "idx_patients_employee_id")
  @@index([linkedUserId], map: "idx_patients_linked_user")
  @@map("patient_profiles")
}

model MedicalOffice {
  id                String    @id @db.VarChar(80)
  name              String    @db.VarChar(180)
  address           String?   @db.VarChar(500)
  phone             String?   @db.VarChar(50)
  email             String?   @db.VarChar(254)
  defaultMedicalFee Decimal   @default(0) @map("default_medical_fee") @db.Decimal(12, 2)
  active            Boolean   @default(true)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  members       MedicalOfficeMember[]
  assignedCases MedicalCase[]

  @@map("medical_offices")
}

model MedicalOfficeMember {
  officeId   String   @map("office_id") @db.VarChar(80)
  userId     String   @map("user_id") @db.VarChar(80)
  memberType String   @map("member_type") @db.VarChar(20)
  canSubmit  Boolean  @default(false) @map("can_submit")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  office MedicalOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([officeId, userId])
  @@index([userId, officeId], map: "idx_office_members_user")
  @@map("medical_office_members")
}

model MedicalCase {
  id                  String    @id @db.VarChar(80)
  patientId           String    @map("patient_id") @db.VarChar(80)
  createdBy           String?   @map("created_by") @db.VarChar(80)
  assignedOfficeId    String?   @map("assigned_office_id") @db.VarChar(80)
  assignedClinicianId String?   @map("assigned_clinician_id") @db.VarChar(80)
  route               String    @db.VarChar(20)
  status              String    @db.VarChar(40)
  paymentStatus       String?   @map("payment_status") @db.VarChar(20)
  payableAmount       Decimal?  @map("payable_amount") @db.Decimal(12, 2)
  casePayload         Bytes?    @map("case_payload")
  payloadKeyVersion    Int       @default(1) @map("payload_key_version") @db.SmallInt
  version             Int       @default(1)
  assignedAt          DateTime? @map("assigned_at") @db.Timestamptz(6)
  patientSubmittedAt  DateTime? @map("patient_submitted_at") @db.Timestamptz(6)
  doctorSubmittedAt   DateTime? @map("doctor_submitted_at") @db.Timestamptz(6)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy          String?   @map("reviewed_by") @db.VarChar(80)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  patient           PatientProfile  @relation(fields: [patientId], references: [id])
  creator           AppUser?        @relation("CaseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  assignedOffice    MedicalOffice?  @relation(fields: [assignedOfficeId], references: [id], onDelete: SetNull)
  assignedClinician AppUser?        @relation("CaseAssignedClinician", fields: [assignedClinicianId], references: [id], onDelete: SetNull)
  reviewer          AppUser?        @relation("CaseReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  submissions       MedicalSubmission[]
  attachments       CaseAttachment[]

  @@index([patientId, createdAt(sort: Desc)], map: "idx_cases_patient_created")
  @@index([status, updatedAt(sort: Desc)], map: "idx_cases_status_updated")
  @@index([assignedOfficeId, status, updatedAt(sort: Desc)], map: "idx_cases_office_status")
  @@index([assignedClinicianId, status, updatedAt(sort: Desc)], map: "idx_cases_clinician_status")
  @@index([paymentStatus, updatedAt(sort: Desc)], map: "idx_cases_payment_status")
  @@map("medical_cases")
}

model MedicalSubmission {
  id                String    @id @db.VarChar(80)
  caseId            String    @map("case_id") @db.VarChar(80)
  submittedBy       String?   @map("submitted_by") @db.VarChar(80)
  submissionVersion Int       @default(1) @map("submission_version")
  encryptedPayload  Bytes     @map("encrypted_payload")
  payloadKeyVersion  Int       @default(1) @map("payload_key_version") @db.SmallInt
  payloadSha256     String    @map("payload_sha256") @db.Char(64)
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz(6)

  case      MedicalCase @relation(fields: [caseId], references: [id])
  submitter AppUser?    @relation("SubmissionSubmittedBy", fields: [submittedBy], references: [id], onDelete: SetNull)

  @@index([caseId, submissionVersion(sort: Desc)], map: "idx_submissions_case_version")
  @@map("medical_submissions")
}

model CaseAttachment {
  id           String    @id @db.VarChar(80)
  caseId       String    @map("case_id") @db.VarChar(80)
  uploadedBy   String?   @map("uploaded_by") @db.VarChar(80)
  storageKey   String    @map("storage_key") @db.VarChar(500)
  originalName String    @map("original_name") @db.VarChar(255)
  contentType  String    @map("content_type") @db.VarChar(100)
  byteSize     BigInt    @map("byte_size")
  sha256       String    @db.Char(64)
  scanStatus   String    @default("pending") @map("scan_status") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  case     MedicalCase @relation(fields: [caseId], references: [id])
  uploader AppUser?    @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt(sort: Desc)], map: "idx_attachments_case_created")
  @@map("case_attachments")
}

model AuditEvent {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId  String?  @map("actor_user_id") @db.VarChar(80)
  eventType    String   @map("event_type") @db.VarChar(120)
  entityType   String?  @map("entity_type") @db.VarChar(60)
  entityId     String?  @map("entity_id") @db.VarChar(80)
  requestId    String?  @map("request_id") @db.VarChar(80)
  sourceIpHash String?  @map("source_ip_hash") @db.Char(64)
  details      Json     @default("{}")
  prevHash     String?  @map("prev_hash") @db.Char(64)
  eventHash    String   @map("event_hash") @db.Char(64)

  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_actor_time")
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "idx_audit_entity_time")
  @@index([eventType, occurredAt(sort: Desc)], map: "idx_audit_type_time")
  @@map("audit_events")
}

model ApplicationSetting {
  settingKey        String   @id @map("setting_key") @db.VarChar(120)
  encryptedValue    Bytes    @map("encrypted_value")
  payloadKeyVersion  Int      @default(1) @map("payload_key_version") @db.SmallInt
  updatedBy         String?  @map("updated_by") @db.VarChar(80)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updater AppUser? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("application_settings")
}
