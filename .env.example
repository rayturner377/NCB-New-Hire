# Copy to .env for local configuration.
# Production should provide APP_MASTER_KEY from a secret manager.

PORT=8080
HOST=127.0.0.1
APP_NAME=National Commercial Bank Jamaica Medical Platform
PUBLIC_URL=http://localhost:8080

# Optional 32-byte base64 key. If omitted, a local data/master.key is generated.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=

# Secure by default (any value other than the literal string "false" counts as secure) — only
# set this to false for local HTTP dev with no TLS. Leaving it unset in a real deployment is safe;
# it does NOT fall back to insecure.
COOKIE_SECURE=false

# Inactivity timeout for authenticated sessions. Allowed range is 5-480 minutes.
SESSION_TIMEOUT_MINUTES=15

# Optional first-run users. If omitted, generated passwords are placed in data/bootstrap-credentials.txt.
INIT_REVIEWER_EMAIL=hr-review@ncb.local
INIT_REVIEWER_PASSWORD=
INIT_CLINICIAN_EMAIL=doctor@ncb.local
INIT_CLINICIAN_PASSWORD=
INIT_ADMIN_EMAIL=admin@ncb.local
INIT_ADMIN_PASSWORD=

# Notification recipient. Keep medical details out of email.
REVIEW_NOTIFICATION_EMAIL=hr-review@ncb.local
FROM_EMAIL=no-reply@ncb.local

# SMTP is optional for local testing. Without it, notifications are logged to data/notifications.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true

# Optional SQL database foundation.
# When DATABASE_ENABLED=true, startup fails if the connection or migrations fail.
# Supported providers: postgres, mysql, mariadb, cloudsql.
DATABASE_ENABLED=false
DATABASE_PROVIDER=postgres
# environment or settings. Environment is recommended for production.
DATABASE_CONFIG_SOURCE=environment

# For Google Cloud SQL set DATABASE_PROVIDER=cloudsql, select the engine below,
# and provide the mounted Unix socket path.
CLOUDSQL_DIALECT=postgres
CLOUDSQL_SOCKET_PATH=

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=ncb_medical
DATABASE_USER=
DATABASE_PASSWORD=

# Recommended in production: require with a trusted CA.
# Values: require, no-verify, disable. Do not use no-verify or disable in production.
DATABASE_SSL_MODE=require
# PEM values may use literal newlines or escaped \n sequences.
DATABASE_SSL_CA=
DATABASE_SSL_CERT=
DATABASE_SSL_KEY=

# Automatic schema migrations are protected by a database advisory lock.
DATABASE_AUTO_MIGRATE=true
# Usually false in production. Prefer provisioning the database separately.
DATABASE_AUTO_CREATE=false

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Local Postgres via docker-compose.yml (packages/database / Prisma cutover).
# Uses host port 5433 to avoid colliding with other Postgres containers on this machine.
# POSTGRES_PASSWORD is read by docker-compose.yml; DATABASE_URL is read by Prisma
# (packages/database). Dotenv does not expand ${VAR} references, so paste the same
# password literally into both lines rather than referencing POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ncb_medical_app:<same-password-as-POSTGRES_PASSWORD>@127.0.0.1:5433/ncb_medical?schema=public
