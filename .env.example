# Copy to .env for local configuration.
# Production should provide APP_MASTER_KEY from a secret manager.

# Optional 32-byte base64 key. If omitted, a local apps/web/data/master.key is generated.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=

# Secure by default (any value other than the literal string "false" counts as secure) — only
# set this to false for local HTTP dev with no TLS. Leaving it unset in a real deployment is safe;
# it does NOT fall back to insecure.
COOKIE_SECURE=false

# Inactivity timeout for authenticated sessions. Allowed range is 5-480 minutes.
SESSION_TIMEOUT_MINUTES=15

# Read by docker-compose.yml's postgres/migrate/web services.
POSTGRES_PASSWORD=

# Read by Prisma (packages/database) and by apps/web at runtime.
# Dotenv does not expand ${VAR} references, so paste the same password
# literally here as in POSTGRES_PASSWORD above.
# - Local dev against docker-compose's postgres service (host port 5433):
DATABASE_URL=postgresql://ncb_medical_app:<same-password-as-POSTGRES_PASSWORD>@127.0.0.1:5433/ncb_medical?schema=public
# - Inside docker-compose itself, the app/migrate services override this to
#   point at the postgres service by its container hostname instead.

# SMTP, notification templates, portal branding, and SLA definitions are
# configured through the Settings admin UI once logged in — not env vars.
